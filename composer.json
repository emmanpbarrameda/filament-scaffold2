{
    "name": "emmanpbarrameda/filament-scaffold2",
    "description": "Scaffold Manager for Filament v4/v5: generate migrations, models, resources, policies, controllers and API services from your panel. Based on solution-forest/filament-scaffold.",
    "keywords": [
        "emmanpbarrameda",
        "laravel",
        "filament",
        "filament-plugin",
        "scaffold",
        "generator",
        "crud"
    ],
    "homepage": "https://github.com/emmanpbarrameda/filament-scaffold2",
    "support": {
        "issues": "https://github.com/emmanpbarrameda/filament-scaffold2/issues",
        "source": "https://github.com/emmanpbarrameda/filament-scaffold2"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Emmanuel P. Barrameda",
            "homepage": "https://emmanpbarrameda.github.io",
            "role": "Developer"
        },
        {
            "name": "Solution Forest (original filament-scaffold)",
            "homepage": "https://github.com/solutionforest/filament-scaffold",
            "role": "Original author"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.9|^8.0",
        "nunomaduro/larastan": "^2.0.1",
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.1|^3.0",
        "pestphp/pest-plugin-arch": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Emmanpbarrameda\\FilamentScaffold2\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emmanpbarrameda\\FilamentScaffold2\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Emmanpbarrameda\\FilamentScaffold2\\FilamentScaffoldServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
